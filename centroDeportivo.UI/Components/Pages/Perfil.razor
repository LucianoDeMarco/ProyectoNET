@page "/perfil"
@rendermode InteractiveServer
@using centroDeportivo.Aplicacion
@using centroDeportivo.Aplicacion.CasosDeUso
@using centroDeportivo.Aplicacion.Seguridad
@using centroDeportivo.UI.Servicios
@inject SesionService Sesion
@inject ModificarUsuarioUseCase ModificarUsuarioUC
@inject NavigationManager Nav
@inject ServicioHash HashService

<PageTitle>Mi Perfil - Centro Deportivo</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0"><i class="bi bi-person-circle"></i> Mis Datos Personales</h3>
                </div>
                <div class="card-body">
                    @if (Sesion.UsuarioActual == null)
                    {
                        <div class="alert alert-warning">Debes iniciar sesión para ver esta página.</div>
                    }
                    else
                    {
                        <EditForm Model="@usuarioEditado" OnValidSubmit="GuardarCambios" FormName="formPerfil">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label">Nombre</label>
                                <InputText @bind-Value="usuarioEditado.Nombre" class="form-control" />
                                <ValidationMessage For="@(() => usuarioEditado.Nombre)" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Apellido</label>
                                <InputText @bind-Value="usuarioEditado.Apellido" class="form-control" />
                                <ValidationMessage For="@(() => usuarioEditado.Apellido)" class="text-danger" />
                            </div>

                            <hr />
                            <h5 class="text-muted mb-3">Seguridad</h5>

                            <div class="mb-3">
                                <label class="form-label">Nueva Contraseña (opcional)</label>
                                <InputText @bind-Value="nuevaPassword" type="password" class="form-control" placeholder="********" />
                            </div>

                            @* --- AGREGADO: Confirmación de Clave --- *@
                            @if (!string.IsNullOrEmpty(nuevaPassword))
                            {
                                <div class="mb-3">
                                    <label class="form-label">Repetir Nueva Contraseña</label>
                                    <InputText @bind-Value="confirmarPassword" type="password" class="form-control" placeholder="********" />
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(mensaje))
                            {
                                <div class="alert @(esError ? "alert-danger" : "alert-success")">
                                    @if(esError) { <i class="bi bi-exclamation-triangle-fill"></i> } else { <i class="bi bi-check-circle-fill"></i> }
                                    @mensaje
                                </div>
                            }

                            <div class="d-grid gap-2 mt-4">
                                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                                <button type="button" class="btn btn-secondary" @onclick="Volver">Cancelar</button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Usuario usuarioEditado = new();
    private string nuevaPassword = "";
    
    // Nueva variable para confirmar
    private string confirmarPassword = ""; 
    
    private string? mensaje;
    private bool esError = false;

    protected override void OnInitialized()
    {
        if (Sesion.UsuarioActual != null)
        {
            // Clonamos los datos
            usuarioEditado.Id = Sesion.UsuarioActual.Id;
            usuarioEditado.Nombre = Sesion.UsuarioActual.Nombre;
            usuarioEditado.Apellido = Sesion.UsuarioActual.Apellido;
            usuarioEditado.Mail = Sesion.UsuarioActual.Mail;
            usuarioEditado.Password = Sesion.UsuarioActual.Password;
            // Ojo: Copiamos la referencia de la lista, pero para perfil está bien
            usuarioEditado.ListaPermisos = Sesion.UsuarioActual.ListaPermisos;
        }
        else
        {
            Nav.NavigateTo("/login");
        }
    }

    private void GuardarCambios()
    {
        try
        {
            // 1. Validar que las contraseñas coincidan
            if (!string.IsNullOrWhiteSpace(nuevaPassword))
            {
                if (nuevaPassword != confirmarPassword)
                {
                    mensaje = "Las contraseñas no coinciden.";
                    esError = true;
                    return;
                }
                
                // Si coinciden, hasheamos y asignamos
                usuarioEditado.Password = HashService.CalcularHash(nuevaPassword);
            }

            // 2. Guardar en DB
            // Pasamos 'false' porque ya la hasheamos nosotros arriba (o dejamos la vieja hasheada)
            ModificarUsuarioUC.Ejecutar(Sesion.UsuarioActual!, usuarioEditado, false);
            
            // 3. Actualizar Sesión Local
            Sesion.IniciarSesion(usuarioEditado);
            
            mensaje = "Datos actualizados correctamente.";
            nuevaPassword = "";
            confirmarPassword = ""; // Limpiamos
            esError = false;
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            esError = true;
        }
    }

    private void Volver() => Nav.NavigateTo("/dashboard"); // Mejor volver al dashboard que al home
}